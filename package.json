{
  "name": "openshop",
  "version": "0.25.0",
  "private": true,
  "description": "Single-file browser image editor test harness",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "security:check": "node tools/security.mjs --check",
    "security:write": "node tools/security.mjs --write",
    "test:release": "npm run security:check && npm audit --audit-level=high && npm test && npm run test:e2e && npm run test:cross-browser",
    "test:cross-browser": "playwright test --project=firefox --project=webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "jsdom": "^27.2.0",
    "vitest": "^4.0.15",
    "vitest-canvas-mock": "^0.3.3"
  }
}
